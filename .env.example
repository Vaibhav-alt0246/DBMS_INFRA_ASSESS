# DATABASE_URL=postgresql://user:password@localhost:5432/infraassess_test
PGHOST=localhost
PGPORT=5432
PGCONNECT_TIMEOUT=5
PGDATABASE=infraassess_test
PGUSER=
PGPASSWORD=
QDRANT_PATH=data/qdrant_storage
FRONTEND_ORIGIN=http://localhost:3000

# Required: JSON mapping SHA-256 token digests to name/role objects. See docs/OPERATIONS.md.
INFRAASSESS_CREDENTIALS={}
API_REQUESTS_PER_MINUTE=300
# Use server mode for concurrent API/worker processes.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=infra_incidents
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_OFFLINE=0
SYNC_INTERVAL_SECONDS=60
FRONTEND_ORIGINS=http://localhost:3000
