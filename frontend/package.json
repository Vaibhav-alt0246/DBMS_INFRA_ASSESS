{
  "name": "infraassess-frontend",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsc app/payload.ts app/payload.test.ts app/error-format.ts app/error-format.test.ts --outDir .test-build --module commonjs --target es2020 --skipLibCheck && node .test-build/payload.test.js && node .test-build/error-format.test.js",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "20.17.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
